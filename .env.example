# Copy to .env. Setup asks for credentials interactively; no default password.
HOST=127.0.0.1
PORT=3100
APP_ORIGIN=http://127.0.0.1:3100
DATABASE_PATH=data/company.sqlite
# Set true only behind an HTTPS reverse proxy. Local HTTP requires false.
SECURE_COOKIES=false
# Phase 2: optional Shopify read connection. Leave blank to keep disconnected.
# Get the company ID from the Shopify store page. No credentials in chat/UI.
SHOPIFY_COMPANY_ID=
SHOPIFY_SHOP_DOMAIN=
# For an app and store owned by the SAME Shopify organization:
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Alternative: an already-issued Admin API token; do not set both methods.
SHOPIFY_ACCESS_TOKEN=
# Customer summaries also require explicit CEO authorization in the app.
SHOPIFY_CUSTOMERS_ENABLED=false
# Optional Phase 5 image generation. Disabled unless all values are configured,
# the CEO selects OPENAI, sets budgets, and approves/runs an exact queued job.
IMAGE_COMPANY_ID=
IMAGE_GENERATION_ENABLED=false
OPENAI_API_KEY=

# Phase 6: separate app credentials; disabled unless explicitly opted in.
SHOPIFY_DRAFT_WRITES_ENABLED=false
SHOPIFY_WRITE_COMPANY_ID=
SHOPIFY_WRITE_SHOP_DOMAIN=
SHOPIFY_WRITE_ACCESS_TOKEN=

# Phase 9: optional human-triggered public homepage monitoring
UX_MONITOR_COMPANY_ID=
UX_MONITOR_HOST=

# Phase 10: Shopify webhook receipt; requires separate CEO authorization in Operations
SHOPIFY_WEBHOOK_COMPANY_ID=
SHOPIFY_WEBHOOK_DOMAIN=
SHOPIFY_WEBHOOK_SECRET=

# Phase 13: local bounded internal-only scheduler, off by default
AUTOMATION_ENABLED=false
